# Sibling repos — source of truth for scripts/bootstrap (and pull-all / status-all / branch-all).
#
# Canonical file in the brain repo: sibling-repos.env (committed, shared).
# init.sh seeds it when --type multi-repo [--repos ...] runs.
# scripts/lib/common.sh loads sibling-repos.env automatically — no export / source needed.
# Do NOT list repos in common.sh; every KEY ending in _REPO_URL is a sibling to clone.
#
# Naming rule: directory name → UPPERCASE, "-" → "_", then suffix _REPO_URL
#   portal-mf             →  PORTAL_MF_REPO_URL
#   my-project-backend    →  MY_PROJECT_BACKEND_REPO_URL
#   payments-api          →  PAYMENTS_API_REPO_URL
#
# !!! PLACEHOLDERS — must be edited before bootstrap works !!!
# The values below are EXAMPLES only. Replace YOUR_BITBUCKET_WORKSPACE with your
# real Bitbucket Cloud workspace slug, and replace repo names with your siblings.
# Leaving these placeholders unchanged will cause ./scripts/bootstrap to fail.
#
# Clone protocol: Bitbucket SSH ONLY.
#   Allowed:  git@bitbucket.org:<workspace>/<repo>.git
#   Forbidden: https://bitbucket.org/...  (HTTPS is NEVER allowed)
#
# Do NOT put machine-specific paths here (e.g. HARNESS_WORKSPACE_DIR).
# Override that locally if needed: export HARNESS_WORKSPACE_DIR="/path/to/workspace"

PORTAL_MF_REPO_URL="git@bitbucket.org:YOUR_BITBUCKET_WORKSPACE/portal-mf.git"
MY_PROJECT_BACKEND_REPO_URL="git@bitbucket.org:YOUR_BITBUCKET_WORKSPACE/my-project-backend.git"
MY_PROJECT_FRONTEND_REPO_URL="git@bitbucket.org:YOUR_BITBUCKET_WORKSPACE/my-project-frontend.git"
